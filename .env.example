# CTBA crawler target
CTBA_URL=http://www.ctba.org.tw/news.php?cate=works&type=16
CTBA_KEYWORD=裁判講習
STATE_FILE=state/ctba_seen.json

# LINE credentials (choose one token source)
# Option A: direct token value
LINE_CHANNEL_ACCESS_TOKEN=YOUR_LINE_CHANNEL_ACCESS_TOKEN
# Option B: token file path (recommended in production)
# LINE_CHANNEL_ACCESS_TOKEN_FILE=secrets/line_token.txt

# LINE recipients (comma or newline separated)
# Option A: direct value
LINE_TO=Uxxxxxxxxxxxxxxx,Cxxxxxxxxxxxxxxx
# Option B: recipients file path
# LINE_TO_FILE=secrets/line_to.txt
